# CVKu production env template
# Copy to .env on the server: cp .env.example .env && nano .env
# Never commit .env to git (already in .gitignore and .dockerignore)

# --- Database (used by docker-compose.yml substitution) ---
POSTGRES_USER=cvku
POSTGRES_PASSWORD=CHANGE_ME_TO_LONG_RANDOM_STRING
POSTGRES_DB=cvku

# --- AI provider (Novita AI direct) ---
NOVITA_API_KEY=sk-...your-novita-key-here
ADMIN_TOKEN=

# --- ATS Checker AI Gateway (9router on :20129) ---
NINEROUTER_BASE_URL=http://192.168.1.89:20129/v1
NINEROUTER_API_KEY=

# --- Admin auth (iron-session cookie encryption) ---
# 32+ char random string, used to seal session cookies. Generate:
#   openssl rand -base64 32
IRON_SESSION_PASSWORD=
